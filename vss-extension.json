{
    "manifestVersion": 1,
    "id": "fabric-automation-tools-dev",
    "publisher": "ms-fabric-api",
    "version": "0.1.0",
    "name": "Fabric automation tools",
    "description": "Fabric public api automation tools",
    "public": false,
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "categories": [
        "Azure Pipelines"
    ],
    "tags": [
        "Fabric"
    ],
    "branding": {
        "color": "#F3F2F1",
        "theme": "light"
    },
    "icons": {
        "default": "Icons/icon.png"
    },
    "screenshots": [
        {
            "path": "Screenshots/Tasks.png"
        }
    ],
    "content": {
        "details": {
            "path": "overview.md"
        },
        "license": {
            "path": "LICENSE"
        }
    },
    "links": {
        "getstarted": {
            "uri": "https://github.com/microsoft/ms-fabric-azure-devops-extensions/blob/main/Docs/getting_started.md"
        },
        "support": {
            "uri": "https://github.com/microsoft/ms-fabric-azure-devops-extensions/blob/main/SUPPORT.md"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/microsoft/ms-fabric-azure-devops-extensions"
    },
    "contributions": [
        {
            "id": "Run_Fabric_CLI",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "Tasks/Run_Fabric_CLI"
            }
        }
    ],
    "files": [
        {
            "path": "Tasks/Run_Fabric_CLI"
        }
    ]
}